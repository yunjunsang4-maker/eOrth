# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# 구글 서비스 계정 키(FCM V1 푸시·Play 제출용) — google-services.json 은 공개값이라
# 커밋하지만, 이 파일들은 비밀키다. 확장자가 .json 이라 위 패턴에 안 걸려 따로 막는다.
*-firebase-adminsdk-*.json
service-account*.json
google-service-account*.json
play-service-account*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# scratch / 임시 생성 파일 (실수 커밋 방지)
cg_tmp.js
*_tmp.js

# generated native folders
/ios
/android

# IDE / tooling artifacts
.idea/
.understand-anything/

# Brainstorming visual companion
.superpowers/

# Supabase keys
# ⚠️ `.env` 만 두면 .env.production / .env.development / .env.preview 가 걸러지지 않는다
#    (실측 확인). EAS 빌드 프로필별 env 파일은 출시 준비 중 흔히 만들게 되므로 전부 막고
#    템플릿인 .env.example 만 예외로 허용한다.
.env*
!.env.example

# 서명 자격증명 — /ios /android 디렉터리 무시로 대부분 덮이지만 루트에 두는 경우 대비
*.keystore
GoogleService-Info.plist

# Supabase CLI 로컬 캐시(링크 정보 등) — 커밋 금지
supabase/.temp/
scripts/geo-tmp/

# 에셋 작업용 일회성 스크립트·중간 산출물 — 디스크에는 남기고 커밋만 제외.
# (EAS 빌드는 git 상태로 아카이브를 만들어서, 미추적 파일이 있으면 빌드가 멈춘다)
scripts/intro1/
scripts/tmp-frames/
scripts/check-antarctica*.js
scripts/check-orb-sharpness.js
scripts/measure-orb-dot.js
scripts/verify-orb-layers.js
scripts/build-import-orb-layers.js
scripts/orb-src.svg
scripts/orb-export.png

# 테스트 Supabase용 스키마 치환 생성물 (make-test-schema.mjs 산출물, 비추적)
supabase/test-schema.local.sql

# 하네스(release-gate·platform-parity 등) 중간 산출물 — 디스크에는 남기고 커밋만 제외.
# 미추적으로 두면 EAS 빌드가 멈춘다(위 scripts/ 항목과 같은 이유).
_workspace/

# 행사 매칭 리포트 — 참가자 인스타 아이디가 들어 있는 로컬 산출물(커밋 금지)
# 타임별·날짜별 리포트(event-report-slot1.local.html, event-report-2026-09-09-slot1.local.html 등)까지
# 덮도록 와일드카드로 둔다 — 파일명 하나만 적어 두면 새 산출물이 조용히 추적 대상이 된다.
event-report*.local.html

# 예약 실행(scripts/event-day-run.ps1)이 실패했을 때 만드는 사유 화면.
# CLI의 stdout+stderr가 통째로 들어가므로 참가자 아이디·경로가 섞일 수 있다.
event-error.local.html

# 다음 날로 넘길 이월 명단(--slot 2 실행이 만든다). **참가자 행 전체**가 들어 있다 —
# 이름·인스타 아이디·설문 응답까지 그대로다. 리포트와 같은 이유로 커밋 금지.
# 날짜별로 갈리므로(event-carry-2026-09-09.local.json) 와일드카드로 둔다.
event-carry-*.local.json

# 부스 뽑기 실제 토큰(커밋 금지). 이 저장소는 공개라 토큰이 커밋되는 순간
# 링크를 아는 누구나 소스에서 꺼내 재고를 뽑아갈 수 있다.
# 템플릿인 supabase/draw-tokens.example.sql 만 추적한다.
# 와일드카드로 둔 이유는 위 리포트와 같다 — 이름 하나만 적어 두면 변형(draw-tokens-d2.local.sql
# 같은 것)이 조용히 추적 대상이 된다.
supabase/draw-tokens*.local.sql
